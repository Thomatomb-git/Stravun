rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId); // Klien bebas update poin/statistik (Client-Trust Model)
      allow delete: if false;
    }

    // Runs collection
    match /runs/{runId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // FIX KRUSIAL: Pemilik post bisa edit/delete. Orang lain HANYA bisa update likeCount/commentCount
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Likes subcollection
      match /likes/{likeId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && likeId == request.auth.uid;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // Missions collection
    match /missions/{missionId} {
      allow read: if isAuthenticated();
      // Klien boleh generate misi baru, tapi dilarang keras menghapus (Delete)
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // User Missions Progress collection
    match /userMissions/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && docId.matches(request.auth.uid + '_.*');
      allow delete: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
